# Copy this file to ".env" (same folder) and fill in YOUR values.
# Each person / computer keeps its own .env - it is never shared.

# ---- MSD login (all other reports) ----
# Microsoft login email
EMAIL=your-msd-id@rebridge.co.in
# Royal Enfield SSO username
USERNAME=your-msd-id
PASSWORD=your-password-here

# ---- Parts login (Parts stock, REAssure Incentive Claims, Service claim report) ----
PARTS_EMAIL=your-claims-id@rebridge.co.in
PARTS_USERNAME=your-claims-id
PARTS_PASSWORD=your-password-here

# ---- Optional: more than one branch ----
# List the branches; every report is then downloaded for each, into downloads\<day>\<branch>\.
# Each branch has its own logins, named after it (instead of the EMAIL= / PARTS_EMAIL= lines above):
# BRANCHES=Udumalpet, Pollachi
# UDUMALPET_EMAIL=...            UDUMALPET_USERNAME=...        UDUMALPET_PASSWORD=...
# UDUMALPET_PARTS_EMAIL=...      UDUMALPET_PARTS_USERNAME=...  UDUMALPET_PARTS_PASSWORD=...
# POLLACHI_EMAIL=...             POLLACHI_USERNAME=...         POLLACHI_PASSWORD=...
# POLLACHI_PARTS_EMAIL=...       POLLACHI_PARTS_USERNAME=...   POLLACHI_PARTS_PASSWORD=...

# ---- Optional ----
# MSD address (default: https://royalenfield.operations.dynamics.com/)
# MSD_URL=https://royalenfield.operations.dynamics.com/

# ---- Optional: Paisa (Money Management app) ----
# After the Job Card Invoice Statement / Invoice statement download, file the day's income
# (without GST) in this Paisa book. Leave PAISA_DIR out to switch it off.
# PAISA_DIR=D:\Claude\VS Code Projects\Money Management
# PAISA_BOOK=bharat-motors-udt
